# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# ─── Robot connection (rosbridge) ────────────────────────────────────────────
# WebSocket URL of the rosbridge server running on the robot's Raspberry Pi.
# Start it on the Pi with:
#     ros2 launch web_bridge web_bridge.launch.py
#
# Use the Pi's LAN address. ws://localhost:9090 only works when you are running
# scripts/mock_ros.cjs locally (npm run dev:ros), or when the browser is on the
# Pi itself.
VITE_ROS_BRIDGE_URL=ws://192.168.1.23:9090

# ─── Backend API ─────────────────────────────────────────────────────────────
# VITE_API_URL=http://localhost:5000
